.venv/
__pycache__/
*.py[cod]
.DS_Store
*.swp
~$*

# Source videos stay local. Keep the five category directories and corner CSVs.
inputs/archive/
inputs/**/*.mp4
inputs/**/*.mov
inputs/**/*.mkv
!inputs/**/.gitkeep
runs/*
!runs/.gitkeep

# Guardrails in case ad-hoc media files are written outside runs/.
*.mp4
*.jpg
*.jpeg
*.png
*.trf

# LaTeX build products; keep source documents and final PDFs only.
*.aux
*.log
*.nav
*.out
*.snm
*.toc

# Third-party experiments stay local unless explicitly documented and committed.
third_party/*
!third_party/README.md

# Local Claude Code tool configuration stays on disk, not in git.
.claude/
