.venv/
__pycache__/
*.py[cod]
.DS_Store
*.swp
~$*

# Source videos and local corner annotations stay local.
inputs/archive/
inputs/**/*.mp4
inputs/**/*.mov
inputs/**/*.mkv
inputs/**/*.csv
!inputs/**/.gitkeep
runs/*
!runs/.gitkeep

# Guardrails in case ad-hoc media files are written outside runs/.
*.mp4
*.jpg
*.jpeg
*.png
*.trf

# Generated paper/report outputs; keep Markdown, CSV, JSON evidence, and references tracked.
/doc/paper/data_requirements_and_workflow_zh.html
/doc/paper/data_requirements_report_artifact.json
/doc/paper/results/ablation/ablation_report.html
/doc/paper/results/ablation/ablation_report_artifact.json
/doc/paper/manuscript/*.pdf
/doc/paper/manuscript/figures/placeholders/

# LaTeX build products.
*.aux
*.log
*.nav
*.out
*.snm
*.toc

# Third-party experiments stay local unless explicitly documented and committed.
third_party/*
!third_party/README.md

# Local Claude Code tool configuration stays on disk, not in git.
.claude/
